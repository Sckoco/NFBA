# Template: copy to .env.dev (npm start) or .env.prod (npm run prod) and fill in the values.
# Never put real values in this file.

DISCORD_TOKEN=
# Discord user ID of the bot owner (for ownerOnly commands)
OWNER_ID=

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

BIRTHDAY_CHANNEL_ID=
# Cron expression for the daily birthday check, e.g. "0 9 * * *" for 09:00
SCHEDULE_TIME=
# Optional IANA timezone, defaults to Europe/Brussels
TIMEZONE=

# Set NODE_ENV=development in .env.dev to log database queries (they contain user IDs).
# Set NODE_ENV=production in .env.prod. Any other value (or none) disables development-only logs.
NODE_ENV=
